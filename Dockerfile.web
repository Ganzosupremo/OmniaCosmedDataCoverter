FROM python:3.11-slim
WORKDIR /app

# Install shared dependencies
COPY requirements.txt /tmp/base-requirements.txt
RUN pip install --no-cache-dir -r /tmp/base-requirements.txt

# Install web-specific dependencies
COPY cosmed-data-converter-web/requirements.txt /tmp/web-requirements.txt
RUN pip install --no-cache-dir -r /tmp/web-requirements.txt

COPY . /app

CMD ["streamlit", "run", "cosmed-data-converter-web/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
